<Window x:Class="HelpDesk_System.Windows.WorkerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:enums="clr-namespace:HelpDesk_System.Models.Enums"
        Title="User workspace"
        Style="{StaticResource WorkspaceWindowStyle}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate x:Key="EnumOptionTemplate">
            <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}"/>
        </DataTemplate>

        <DataTemplate x:Key="UserTicketCardTemplate">
            <Button Style="{StaticResource TicketCardButtonStyle}"
                    Click="TicketCard_Click">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource TicketBadgeStyle}">
                        <TextBlock Text="{Binding Priority, Converter={StaticResource EnumDisplayConverter}}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource FieldTextBrush}"/>
                    </Border>

                    <TextBlock Grid.Column="1"
                               Text="{Binding Status, Converter={StaticResource EnumDisplayConverter}}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource FieldTextBrush}"/>

                    <TextBlock Grid.Row="1"
                               Grid.ColumnSpan="2"
                               Text="{Binding Title}"
                               Margin="0,11,0,8"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MainTextBrush}"
                               TextTrimming="CharacterEllipsis"/>

                    <StackPanel Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Orientation="Horizontal">
                        <TextBlock Text="{Binding ProblemType, Converter={StaticResource EnumDisplayConverter}}"
                                   Style="{StaticResource SmallMutedTextStyle}"/>
                        <TextBlock Text="  •  "
                                   Style="{StaticResource SmallMutedTextStyle}"/>
                        <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                   Style="{StaticResource SmallMutedTextStyle}"/>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="TicketCommentTemplate">
            <Border Margin="0,0,0,8"
                    Padding="12"
                    Background="{StaticResource InputBackgroundBrush}"
                    BorderBrush="{StaticResource InputBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="9">
                <StackPanel>
                    <TextBlock Text="{Binding Message}"
                               Style="{StaticResource DetailValueTextStyle}"/>
                    <TextBlock Margin="0,7,0,0"
                               Style="{StaticResource SmallMutedTextStyle}">
                        <Run Text="{Binding Author.FirstName}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding Author.LastName}"/>
                        <Run Text="  •  "/>
                        <Run Text="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TicketHistoryEntryTemplate">
            <Border Margin="0,0,0,8"
                    Padding="12"
                    Background="#F8FAFC"
                    CornerRadius="9">
                <StackPanel>
                    <TextBlock Text="{Binding Description}"
                               Style="{StaticResource DetailValueTextStyle}"/>
                    <TextBlock Margin="0,7,0,0"
                               Style="{StaticResource SmallMutedTextStyle}">
                        <Run Text="{Binding Actor.FirstName, FallbackValue='Former user'}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding Actor.LastName}"/>
                        <Run Text="  •  "/>
                        <Run Text="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="WorkerKnowledgeBaseTicketCardTemplate">
            <Border
                Margin="0,0,0,12"
                Padding="18"
                Background="{StaticResource InputBackgroundBrush}"
                BorderBrush="{StaticResource InputBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource TicketBadgeStyle}">
                            <TextBlock
                                Text="{Binding Status, Converter={StaticResource EnumDisplayConverter}}"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource FieldTextBrush}"/>
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <TextBlock Text="#" Style="{StaticResource SmallMutedTextStyle}"/>
                            <TextBlock Text="{Binding Id}" Style="{StaticResource SmallMutedTextStyle}"/>
                            <TextBlock Text="  •  " Style="{StaticResource SmallMutedTextStyle}"/>
                            <TextBlock
                                Text="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                Style="{StaticResource SmallMutedTextStyle}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock
                        Text="{Binding Title}"
                        Margin="0,12,0,12"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource MainTextBrush}"
                        TextWrapping="Wrap"/>

                    <TextBlock Text="Problem description" Style="{StaticResource DetailLabelTextStyle}"/>
                    <TextBlock
                        Text="{Binding Description}"
                        Margin="0,0,0,14"
                        Style="{StaticResource DetailValueTextStyle}"/>

                    <Border
                        Padding="12"
                        Background="White"
                        BorderBrush="{StaticResource InputBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9">
                        <StackPanel>
                            <TextBlock Text="Solution" Style="{StaticResource DetailLabelTextStyle}"/>
                            <TextBlock
                                Text="{Binding Responses[0].Message, FallbackValue='No solution comment was added.'}"
                                Style="{StaticResource DetailValueTextStyle}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBackgroundBrush}"
          Loaded="WorkerWindow_Loaded">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Padding="24,18"
                    Margin="0,0,0,18"
                    Style="{StaticResource WorkspaceCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Help Desk"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource MainTextBrush}"/>
                        <TextBlock Text="User workspace"
                                   Margin="0,3,0,0"
                                   Style="{StaticResource SmallMutedTextStyle}"/>
                        <TextBlock x:Name="WorkspaceStatusMessageText"
                                   Margin="0,5,0,0"
                                   Style="{StaticResource WorkspaceErrorTextStyle}"/>
                    </StackPanel>

                    <Button x:Name="KnowledgeBaseButton"
                            Grid.Column="1"
                            Content="Knowledge base"
                            Margin="16,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="KnowledgeBaseButton_Click"/>

                    <Grid Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,16,0"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="UserNameText"
                                       HorizontalAlignment="Right"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource MainTextBrush}"/>
                            <TextBlock x:Name="UserEmailText"
                                       Margin="0,3,0,0"
                                       HorizontalAlignment="Right"
                                       Style="{StaticResource SmallMutedTextStyle}"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="Logout"
                                Style="{StaticResource OutlineButtonStyle}"
                                Click="LogoutButton_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="6*"/>
                </Grid.ColumnDefinitions>

                <Border Padding="22"
                        Margin="0,0,9,0"
                        Style="{StaticResource WorkspaceCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="Create ticket"
                                       Style="{StaticResource SectionTitleTextStyle}"/>
                            <TextBlock Text="Describe the issue and its impact."
                                       Margin="0,5,0,0"
                                       Style="{StaticResource SmallMutedTextStyle}"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,8,0">
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="Title"
                                               Style="{StaticResource FieldLabelTextStyle}"/>
                                    <TextBox x:Name="TitleTextBox"
                                             MaxLength="160"
                                             Style="{StaticResource WorkspaceTextBoxStyle}"/>
                                    <TextBlock x:Name="TitleErrorText"
                                               Margin="0,5,0,0"
                                               Style="{StaticResource WorkspaceErrorTextStyle}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="Description"
                                               Style="{StaticResource FieldLabelTextStyle}"/>
                                    <TextBox x:Name="DescriptionTextBox"
                                             MinHeight="110"
                                             MaxLength="4000"
                                             Style="{StaticResource WorkspaceTextAreaStyle}"/>
                                    <TextBlock x:Name="DescriptionErrorText"
                                               Margin="0,5,0,0"
                                               Style="{StaticResource WorkspaceErrorTextStyle}"/>
                                </StackPanel>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Problem type"
                                                   Style="{StaticResource FieldLabelTextStyle}"/>
                                        <ComboBox x:Name="ProblemTypeComboBox"
                                                  ItemTemplate="{StaticResource EnumOptionTemplate}"
                                                  Style="{StaticResource WorkspaceComboBoxStyle}"/>
                                        <TextBlock x:Name="ProblemTypeErrorText"
                                                   Margin="0,5,0,0"
                                                   Style="{StaticResource WorkspaceErrorTextStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Work impact"
                                                   Style="{StaticResource FieldLabelTextStyle}"/>
                                        <ComboBox x:Name="WorkImpactComboBox"
                                                  ItemTemplate="{StaticResource EnumOptionTemplate}"
                                                  Style="{StaticResource WorkspaceComboBoxStyle}"/>
                                        <TextBlock x:Name="WorkImpactErrorText"
                                                   Margin="0,5,0,0"
                                                   Style="{StaticResource WorkspaceErrorTextStyle}"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="Affected people"
                                               Style="{StaticResource FieldLabelTextStyle}"/>
                                    <ComboBox x:Name="AffectedPeopleComboBox"
                                              ItemTemplate="{StaticResource EnumOptionTemplate}"
                                              Style="{StaticResource WorkspaceComboBoxStyle}"/>
                                    <TextBlock x:Name="AffectedPeopleErrorText"
                                               Margin="0,5,0,0"
                                               Style="{StaticResource WorkspaceErrorTextStyle}"/>
                                </StackPanel>

                                <Button x:Name="SubmitTicketButton"
                                        Content="Send ticket"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="SubmitTicketButton_Click"/>

                                <TextBlock x:Name="FormSuccessMessageText"
                                           Margin="0,12,0,0"
                                           TextAlignment="Center"
                                           Style="{StaticResource WorkspaceSuccessTextStyle}"/>

                                <TextBlock x:Name="FormErrorMessageText"
                                           Margin="0,12,0,0"
                                           TextAlignment="Center"
                                           Style="{StaticResource WorkspaceErrorTextStyle}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Padding="22"
                        Margin="9,0,0,0"
                        Style="{StaticResource WorkspaceCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="My tickets"
                                           Style="{StaticResource SectionTitleTextStyle}"/>
                                <TextBlock x:Name="UserTicketsCountText"
                                           Margin="0,5,0,0"
                                           Style="{StaticResource SmallMutedTextStyle}"/>
                                <TextBlock x:Name="TicketListSuccessMessageText"
                                           Margin="0,5,0,0"
                                           Style="{StaticResource WorkspaceSuccessTextStyle}"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="Refresh"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="RefreshTicketsButton_Click"/>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="190"/>
                            </Grid.ColumnDefinitions>

                            <TextBox
                                x:Name="UserTicketSearchTextBox"
                                MaxLength="160"
                                ToolTip="Search by ticket ID, title or description"
                                Style="{StaticResource WorkspaceTextBoxStyle}"
                                TextChanged="UserTicketSearchTextBox_TextChanged"/>

                            <ComboBox
                                x:Name="UserTicketStatusFilterComboBox"
                                Grid.Column="2"
                                SelectedIndex="0"
                                ToolTip="Filter tickets by status"
                                Style="{StaticResource WorkspaceComboBoxStyle}"
                                SelectionChanged="UserTicketStatusFilterComboBox_SelectionChanged">
                                <ComboBoxItem Content="All statuses"/>
                                <ComboBoxItem Content="Open" Tag="{x:Static enums:TicketStatus.Open}"/>
                                <ComboBoxItem Content="In progress" Tag="{x:Static enums:TicketStatus.InProgress}"/>
                                <ComboBoxItem Content="Resolved" Tag="{x:Static enums:TicketStatus.Resolved}"/>
                                <ComboBoxItem Content="Closed" Tag="{x:Static enums:TicketStatus.Closed}"/>
                                <ComboBoxItem Content="Declined" Tag="{x:Static enums:TicketStatus.Declined}"/>
                            </ComboBox>
                        </Grid>

                        <Grid Grid.Row="2">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="UserTicketsList"
                                              ItemTemplate="{StaticResource UserTicketCardTemplate}"/>
                            </ScrollViewer>

                            <TextBlock x:Name="UserTicketsEmptyText"
                                       Text="You have not submitted any tickets yet."
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       Style="{StaticResource SmallMutedTextStyle}"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border x:Name="TicketDetailsPanel"
                Width="420"
                Margin="0,126,28,28"
                Padding="24"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Style="{StaticResource WorkspaceCardStyle}"
                Panel.ZIndex="5"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22"
                                  ShadowDepth="3"
                                  Opacity="0.2"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Ticket details"
                                   Style="{StaticResource SectionTitleTextStyle}"/>
                        <TextBlock x:Name="DetailsStatusText"
                                   Margin="0,5,0,0"
                                   Style="{StaticResource SmallMutedTextStyle}"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="×"
                            Style="{StaticResource ClosePanelButtonStyle}"
                            Click="CloseDetailsButton_Click"/>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              Margin="0,22,0,18"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Title"
                                   Style="{StaticResource DetailLabelTextStyle}"/>
                        <TextBlock x:Name="DetailsTitleText"
                                   Margin="0,0,0,18"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MainTextBrush}"
                                   TextWrapping="Wrap"/>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Priority"
                                           Style="{StaticResource DetailLabelTextStyle}"/>
                                <TextBlock x:Name="DetailsPriorityText"
                                           Style="{StaticResource DetailValueTextStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Created"
                                           Style="{StaticResource DetailLabelTextStyle}"/>
                                <TextBlock x:Name="DetailsCreatedText"
                                           Style="{StaticResource DetailValueTextStyle}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Problem type"
                                   Style="{StaticResource DetailLabelTextStyle}"/>
                        <TextBlock x:Name="DetailsProblemTypeText"
                                   Margin="0,0,0,16"
                                   Style="{StaticResource DetailValueTextStyle}"/>

                        <TextBlock Text="Work impact"
                                   Style="{StaticResource DetailLabelTextStyle}"/>
                        <TextBlock x:Name="DetailsWorkImpactText"
                                   Margin="0,0,0,16"
                                   Style="{StaticResource DetailValueTextStyle}"/>

                        <TextBlock Text="Affected people"
                                   Style="{StaticResource DetailLabelTextStyle}"/>
                        <TextBlock x:Name="DetailsAffectedPeopleText"
                                   Margin="0,0,0,18"
                                   Style="{StaticResource DetailValueTextStyle}"/>

                        <TextBlock Text="Assigned specialist"
                                   Style="{StaticResource DetailLabelTextStyle}"/>
                        <TextBlock x:Name="DetailsAssignedAdminText"
                                   Margin="0,0,0,18"
                                   Style="{StaticResource DetailValueTextStyle}"/>

                        <TextBlock Text="Description"
                                   Style="{StaticResource DetailLabelTextStyle}"/>
                        <Border Padding="14"
                                Background="{StaticResource InputBackgroundBrush}"
                                BorderBrush="{StaticResource InputBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <TextBlock x:Name="DetailsDescriptionText"
                                       Style="{StaticResource DetailValueTextStyle}"/>
                        </Border>

                        <TextBlock Text="Comments"
                                   Margin="0,18,0,8"
                                   Style="{StaticResource DetailLabelTextStyle}"/>
                        <ItemsControl ItemsSource="{Binding Responses}"
                                      ItemTemplate="{StaticResource TicketCommentTemplate}"/>
                        <TextBlock Text="No comments yet.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource SmallMutedTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Responses.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="Change history"
                                   Margin="0,18,0,8"
                                   Style="{StaticResource DetailLabelTextStyle}"/>
                        <ItemsControl ItemsSource="{Binding HistoryEntries}"
                                      ItemTemplate="{StaticResource TicketHistoryEntryTemplate}"/>
                        <TextBlock Text="No history entries yet.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource SmallMutedTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HistoryEntries.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2">
                    <StackPanel x:Name="WorkerCommentActionsPanel"
                                Margin="0,0,0,14">
                        <TextBlock Text="Comment"
                                   Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBox x:Name="WorkerCommentTextBox"
                                 Margin="0,0,0,10"
                                 Style="{StaticResource WorkspaceTextAreaStyle}"/>
                        <Button x:Name="AddWorkerCommentButton"
                                Content="Add comment"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="AddWorkerCommentButton_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="WorkerCommentErrorText"
                               Margin="0,0,0,10"
                               Style="{StaticResource WorkspaceErrorTextStyle}"/>
                    <TextBlock x:Name="WorkerCommentSuccessText"
                               Margin="0,0,0,10"
                               Style="{StaticResource WorkspaceSuccessTextStyle}"/>

                    <TextBlock x:Name="CloseTicketErrorText"
                               Margin="0,0,0,10"
                               Style="{StaticResource WorkspaceErrorTextStyle}"/>

                    <Button x:Name="CloseTicketButton"
                            Content="Close resolved ticket"
                            Margin="0,0,0,10"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Visibility="Collapsed"
                            Click="CloseTicketButton_Click"/>

                    <TextBlock x:Name="DeleteTicketErrorText"
                               Margin="0,0,0,10"
                               Style="{StaticResource WorkspaceErrorTextStyle}"/>

                    <Button x:Name="DeleteTicketButton"
                            Content="Delete ticket"
                            Style="{StaticResource DangerButtonStyle}"
                            Visibility="Collapsed"
                            Click="DeleteTicketButton_Click"/>

                    <Border x:Name="DeleteTicketConfirmationPanel"
                            Padding="14"
                            Background="{StaticResource InputBackgroundBrush}"
                            BorderBrush="{StaticResource InputBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Delete this ticket?"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource MainTextBrush}"/>
                            <TextBlock Text="This action cannot be undone."
                                       Margin="0,4,0,12"
                                       Style="{StaticResource SmallMutedTextStyle}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="CancelDeleteTicketButton"
                                        Content="Cancel"
                                        Style="{StaticResource OutlineButtonStyle}"
                                        Click="CancelDeleteTicketButton_Click"/>

                                <Button x:Name="ConfirmDeleteTicketButton"
                                        Grid.Column="2"
                                        Content="Delete"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Click="ConfirmDeleteTicketButton_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="KnowledgeBasePanel"
                Margin="28,126,28,28"
                Padding="24"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Style="{StaticResource WorkspaceCardStyle}"
                Panel.ZIndex="7"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22"
                                  ShadowDepth="3"
                                  Opacity="0.2"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Knowledge base"
                                   Style="{StaticResource SectionTitleTextStyle}"/>
                        <TextBlock Text="Published solutions for common problems"
                                   Margin="0,5,0,0"
                                   Style="{StaticResource SmallMutedTextStyle}"/>
                        <TextBlock x:Name="WorkerKnowledgeBaseCountText"
                                   Margin="0,5,0,0"
                                   Style="{StaticResource SmallMutedTextStyle}"/>
                        <TextBlock x:Name="WorkerKnowledgeBaseStatusMessageText"
                                   Margin="0,5,0,0"
                                   Style="{StaticResource WorkspaceErrorTextStyle}"/>
                    </StackPanel>

                    <Button x:Name="RefreshWorkerKnowledgeBaseButton"
                            Grid.Column="1"
                            Content="Refresh"
                            Margin="0,0,12,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="RefreshWorkerKnowledgeBaseButton_Click"/>
                    <Button Grid.Column="2"
                            Content="×"
                            Style="{StaticResource ClosePanelButtonStyle}"
                            Click="CloseKnowledgeBaseButton_Click"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,18,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Search solutions"
                                   Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBox x:Name="WorkerKnowledgeBaseSearchTextBox"
                                 MaxLength="120"
                                 ToolTip="Search by ticket ID, problem or solution"
                                 Style="{StaticResource WorkspaceTextBoxStyle}"
                                 TextChanged="WorkerKnowledgeBaseSearchTextBox_TextChanged"/>
                    </StackPanel>

                    <Button x:Name="ClearWorkerKnowledgeBaseSearchButton"
                            Grid.Column="1"
                            Content="Clear"
                            Margin="12,0,0,0"
                            VerticalAlignment="Bottom"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="False"
                            Click="ClearWorkerKnowledgeBaseSearchButton_Click"/>
                </Grid>

                <Grid Grid.Row="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="WorkerKnowledgeBaseList"
                                      ItemTemplate="{StaticResource WorkerKnowledgeBaseTicketCardTemplate}"/>
                    </ScrollViewer>

                    <TextBlock x:Name="WorkerKnowledgeBaseEmptyText"
                               Text="There are no published solutions yet."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               Style="{StaticResource SmallMutedTextStyle}"
                               Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </Border>

    </Grid>

</Window>
