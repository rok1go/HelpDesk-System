<Window x:Class="HelpDesk_System.Windows.StartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HelpDesk"
        Height="300"
        Width="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <StackPanel
            VerticalAlignment="Center"
            HorizontalAlignment="Center">

            <Button
                Name="LoginButton"
                Content="Login"
                Width="200"
                Height="45"
                Margin="0,0,0,15"
                Click="LoginButton_Click"/>

            <Button
                Name="RegisterButton"
                Content="Register"
                Width="200"
                Height="45"
                Click="RegisterButton_Click"/>

        </StackPanel>

    </Grid>

</Window>