<Window x:Class="HelpDesk_System.Windows.LoginWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="Login"
		WindowStartupLocation="CenterScreen"
		Style="{StaticResource AuthWindowStyle}">

    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Viewbox Style="{StaticResource AuthViewboxStyle}">
            <Border Padding="40" Style="{StaticResource AuthCardStyle}">
                <StackPanel>
                    <TextBlock Text="Help Desk" Margin="0,0,0,10"
							   Style="{StaticResource AuthTitleTextStyle}"/>

                    <TextBlock Text="Sign in to your account" Margin="0,0,0,40"
							   Style="{StaticResource AuthSubtitleTextStyle}"/>

                    <TextBlock Text="Email" Style="{StaticResource FieldLabelTextStyle}"/>

                    <TextBox x:Name="EmailTextBox"
                             MaxLength="80"
                             Style="{StaticResource AuthTextBoxStyle}"/>

                    <TextBlock x:Name="EmailErrorText"
							   Style="{StaticResource AuthErrorTextStyle}"/>

                    <TextBlock Text="Password" Margin="0,22,0,0"
							   Style="{StaticResource FieldLabelTextStyle}"/>

                    <StackPanel Margin="0,0,0,28">
                        <PasswordBox x:Name="PasswordInput"
									 MaxLength="64"
									 Style="{StaticResource AuthPasswordBoxStyle}"/>

                        <TextBlock x:Name="PasswordErrorText"
								   Style="{StaticResource AuthErrorTextStyle}"/>
                    </StackPanel>

                    <Button x:Name="LoginButton" Content="Login"
							Style="{StaticResource PrimaryButtonStyle}"
							Click="LoginButton_Click"/>

                    <Button x:Name="OpenRegisterButton"
							Content="Don't have an account? Register"
							Margin="0,14,0,0"
							Style="{StaticResource LinkButtonStyle}"
							Click="OpenRegisterButton_Click"/>
                </StackPanel>
            </Border>
        </Viewbox>

        <Button x:Name="ExitButton" Content="Exit"
				Style="{StaticResource ExitButtonStyle}"
				Click="ExitButton_Click"/>
    </Grid>
</Window>
