<Window x:Class="HelpDesk_System.Windows.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:enums="clr-namespace:HelpDesk_System.Models.Enums"
        Title="Admin workspace"
        Style="{StaticResource WorkspaceWindowStyle}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate x:Key="TicketCardTemplate">
            <Button Style="{StaticResource TicketCardButtonStyle}" Click="TicketCard_Click">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource TicketBadgeStyle}">
                        <TextBlock
                            Text="{Binding Priority, Converter={StaticResource EnumDisplayConverter}}"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource FieldTextBrush}"/>
                    </Border>

                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{StaticResource SecondaryTextBrush}">
                        <Run Text="{Binding Author.FirstName}"/><Run Text=" "/><Run Text="{Binding Author.LastName}"/>
                    </TextBlock>

                    <TextBlock
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Text="{Binding Title}"
                        Margin="0,11,0,8"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource MainTextBrush}"
                        TextTrimming="CharacterEllipsis"/>

                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal">
                        <TextBlock
                            Text="{Binding Status, Converter={StaticResource EnumDisplayConverter}}"
                            Style="{StaticResource SmallMutedTextStyle}"/>
                        <TextBlock Text="  •  " Style="{StaticResource SmallMutedTextStyle}"/>
                        <TextBlock
                            Text="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                            Style="{StaticResource SmallMutedTextStyle}"/>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="TicketCommentTemplate">
            <Border
                Margin="0,0,0,8"
                Padding="12"
                Background="{StaticResource InputBackgroundBrush}"
                BorderBrush="{StaticResource InputBorderBrush}"
                BorderThickness="1"
                CornerRadius="9">
                <StackPanel>
                    <TextBlock
                        Text="{Binding Message}"
                        Style="{StaticResource DetailValueTextStyle}"/>
                    <TextBlock Margin="0,7,0,0" Style="{StaticResource SmallMutedTextStyle}">
                        <Run Text="{Binding Author.FirstName}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding Author.LastName}"/>
                        <Run Text="  •  "/>
                        <Run Text="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TicketHistoryEntryTemplate">
            <Border
                Margin="0,0,0,8"
                Padding="12"
                Background="#F8FAFC"
                CornerRadius="9">
                <StackPanel>
                    <TextBlock
                        Text="{Binding Description}"
                        Style="{StaticResource DetailValueTextStyle}"/>
                    <TextBlock Margin="0,7,0,0" Style="{StaticResource SmallMutedTextStyle}">
                        <Run
                            Text="{Binding Actor.FirstName, FallbackValue='Former user'}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding Actor.LastName}"/>
                        <Run Text="  •  "/>
                        <Run Text="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RegistrationRequestCardTemplate">
            <Button Style="{StaticResource TicketCardButtonStyle}" Click="RegistrationRequestCard_Click">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource TicketBadgeStyle}">
                        <TextBlock
                            Text="{Binding RequestedRole, Converter={StaticResource EnumDisplayConverter}}"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource FieldTextBrush}"/>
                    </Border>

                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource SmallMutedTextStyle}"/>

                    <TextBlock
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Margin="0,11,0,5"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource MainTextBrush}">
                        <Run Text="{Binding FirstName}"/><Run Text=" "/><Run Text="{Binding LastName}"/>
                    </TextBlock>

                    <TextBlock
                        Grid.Row="2"
                        Grid.ColumnSpan="2"
                        Text="{Binding Email}"
                        Style="{StaticResource SmallMutedTextStyle}"
                        TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Button>
        </DataTemplate>

        <Style
            x:Key="KnowledgeBaseNavigationButtonStyle"
            TargetType="Button"
            BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="Selected">
                    <Setter Property="Background" Value="{StaticResource PrimaryButtonBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="KnowledgeBaseTicketCardTemplate">
            <Border
                Margin="0,0,0,12"
                Padding="18"
                Background="{StaticResource InputBackgroundBrush}"
                BorderBrush="{StaticResource InputBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource TicketBadgeStyle}">
                            <TextBlock
                                Text="{Binding Status, Converter={StaticResource EnumDisplayConverter}}"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource FieldTextBrush}"/>
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <TextBlock Text="#" Style="{StaticResource SmallMutedTextStyle}"/>
                            <TextBlock Text="{Binding Id}" Style="{StaticResource SmallMutedTextStyle}"/>
                            <TextBlock Text="  •  " Style="{StaticResource SmallMutedTextStyle}"/>
                            <TextBlock
                                Text="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                Style="{StaticResource SmallMutedTextStyle}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock
                        Text="{Binding Title}"
                        Margin="0,12,0,12"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource MainTextBrush}"
                        TextWrapping="Wrap"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Author" Style="{StaticResource DetailLabelTextStyle}"/>
                            <TextBlock Style="{StaticResource DetailValueTextStyle}">
                                <Run Text="{Binding Author.FirstName}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding Author.LastName}"/>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Assigned specialist" Style="{StaticResource DetailLabelTextStyle}"/>
                            <TextBlock Style="{StaticResource DetailValueTextStyle}">
                                <Run
                                    Text="{Binding AssignedAdmin.FirstName, FallbackValue='Not assigned'}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding AssignedAdmin.LastName}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Description" Style="{StaticResource DetailLabelTextStyle}"/>
                    <TextBlock
                        Text="{Binding Description}"
                        Margin="0,0,0,14"
                        Style="{StaticResource DetailValueTextStyle}"/>

                    <Border
                        Padding="12"
                        Background="White"
                        BorderBrush="{StaticResource InputBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9">
                        <StackPanel>
                            <TextBlock Text="Attached comment" Style="{StaticResource DetailLabelTextStyle}"/>
                            <TextBlock
                                Text="{Binding Responses[0].Message, FallbackValue='No comment was added.'}"
                                Style="{StaticResource DetailValueTextStyle}"/>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,14,0,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding Status}"
                                        Value="{x:Static enums:TicketStatus.Resolved}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger
                                        Binding="{Binding Status}"
                                        Value="{x:Static enums:TicketStatus.Closed}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style
                                    TargetType="TextBlock"
                                    BasedOn="{StaticResource SmallMutedTextStyle}">
                                    <Setter Property="Text" Value="Visible only to administrators"/>
                                    <Style.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsKnowledgeBasePublished}"
                                            Value="True">
                                            <Setter Property="Text" Value="Published for workers"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Button
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            Click="KnowledgeBasePublicationButton_Click">
                            <Button.Style>
                                <Style
                                    TargetType="Button"
                                    BasedOn="{StaticResource SecondaryButtonStyle}">
                                    <Setter Property="Content" Value="Publish for workers"/>
                                    <Style.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsKnowledgeBasePublished}"
                                            Value="True">
                                            <Setter Property="Content" Value="Hide from workers"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RegistrationArchiveCardTemplate">
            <Border
                Margin="0,0,0,12"
                Padding="16"
                Background="{StaticResource InputBackgroundBrush}"
                BorderBrush="{StaticResource InputBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource TicketBadgeStyle}">
                            <TextBlock
                                Text="{Binding Status, Converter={StaticResource EnumDisplayConverter}}"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource FieldTextBrush}"/>
                        </Border>

                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding ProcessedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                            HorizontalAlignment="Right"
                            Style="{StaticResource SmallMutedTextStyle}"/>
                    </Grid>

                    <TextBlock
                        Margin="0,12,0,3"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource MainTextBrush}">
                        <Run Text="{Binding FirstName}"/><Run Text=" "/><Run Text="{Binding LastName}"/>
                    </TextBlock>
                    <TextBlock
                        Text="{Binding Email}"
                        Margin="0,0,0,12"
                        Style="{StaticResource SmallMutedTextStyle}"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Requested role" Style="{StaticResource DetailLabelTextStyle}"/>
                            <TextBlock
                                Text="{Binding RequestedRole, Converter={StaticResource EnumDisplayConverter}}"
                                Style="{StaticResource DetailValueTextStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Assigned role" Style="{StaticResource DetailLabelTextStyle}"/>
                            <TextBlock
                                Text="{Binding AssignedRole, TargetNullValue='Not assigned'}"
                                Style="{StaticResource DetailValueTextStyle}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource SmallMutedTextStyle}">
                        <Run Text="Processed by "/>
                        <Run
                            Text="{Binding ProcessedByAdmin.FirstName, FallbackValue='Unknown administrator'}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding ProcessedByAdmin.LastName}"/>
                    </TextBlock>

                    <Border
                        Margin="0,12,0,0"
                        Padding="12"
                        Background="White"
                        BorderBrush="{StaticResource InputBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9">
                        <StackPanel>
                            <TextBlock Text="Decision comment" Style="{StaticResource DetailLabelTextStyle}"/>
                            <TextBlock
                                Text="{Binding DecisionReason, TargetNullValue='No decision comment was added.'}"
                                Style="{StaticResource DetailValueTextStyle}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBackgroundBrush}"
          Loaded="AdminWindow_Loaded">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Padding="24,18" Margin="0,0,0,18" Style="{StaticResource WorkspaceCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            Text="Help Desk"
                            FontSize="24"
                            FontWeight="Bold"
                            Foreground="{StaticResource MainTextBrush}"/>
                        <TextBlock
                            Text="Admin workspace"
                            Margin="0,3,0,0"
                            Style="{StaticResource SmallMutedTextStyle}"/>
                        <TextBlock
                            x:Name="WorkspaceStatusMessageText"
                            Margin="0,5,0,0"
                            Style="{StaticResource WorkspaceErrorTextStyle}"/>
                    </StackPanel>

                    <Button
                        x:Name="RegistrationRequestsButton"
                        Grid.Column="1"
                        Content="Registration requests"
                        Margin="16,0,0,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="RegistrationRequestsButton_Click"/>

                    <Button
                        x:Name="KnowledgeBaseButton"
                        Grid.Column="2"
                        Content="Knowledge base"
                        Margin="16,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="KnowledgeBaseButton_Click"/>

                    <Grid Grid.Column="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock
                                x:Name="AdminNameText"
                                HorizontalAlignment="Right"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource MainTextBrush}"/>
                            <TextBlock
                                x:Name="AdminEmailText"
                                Margin="0,3,0,0"
                                HorizontalAlignment="Right"
                                Style="{StaticResource SmallMutedTextStyle}"/>
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Content="Logout"
                            Style="{StaticResource OutlineButtonStyle}"
                            Click="LogoutButton_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*"/>
                    <ColumnDefinition Width="5*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.ColumnSpan="2" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Text="Search active tickets"
                        VerticalAlignment="Center"
                        Style="{StaticResource FieldLabelTextStyle}"/>
                    <TextBox
                        x:Name="AdminTicketSearchTextBox"
                        Grid.Column="1"
                        Margin="14,0,0,0"
                        MaxLength="80"
                        ToolTip="Search by ticket ID, title, description or requester"
                        Style="{StaticResource WorkspaceTextBoxStyle}"
                        TextChanged="AdminTicketSearchTextBox_TextChanged"/>
                </Grid>

                <Border Grid.Row="1" Padding="22" Margin="0,0,9,0" Style="{StaticResource WorkspaceCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Available tickets" Style="{StaticResource SectionTitleTextStyle}"/>
                                <TextBlock
                                    x:Name="OpenTicketsCountText"
                                    Margin="0,5,0,0"
                                    Style="{StaticResource SmallMutedTextStyle}"/>
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Content="Refresh"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="RefreshButton_Click"/>
                        </Grid>

                        <Grid Grid.Row="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl
                                    x:Name="OpenTicketsList"
                                    ItemTemplate="{StaticResource TicketCardTemplate}"/>
                            </ScrollViewer>
                            <TextBlock
                                x:Name="OpenTicketsEmptyText"
                                Text="There are no open tickets."
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Style="{StaticResource SmallMutedTextStyle}"
                                Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Padding="22" Margin="9,0,0,0" Style="{StaticResource WorkspaceCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="My tickets" Style="{StaticResource SectionTitleTextStyle}"/>
                            <TextBlock
                                x:Name="AssignedTicketsCountText"
                                Margin="0,5,0,0"
                                Style="{StaticResource SmallMutedTextStyle}"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl
                                    x:Name="AssignedTicketsList"
                                    ItemTemplate="{StaticResource TicketCardTemplate}"/>
                            </ScrollViewer>
                            <TextBlock
                                x:Name="AssignedTicketsEmptyText"
                                Text="You have not taken any tickets yet."
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Style="{StaticResource SmallMutedTextStyle}"
                                Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border
            x:Name="TicketDetailsPanel"
            Width="420"
            Margin="0,126,28,28"
            Padding="24"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            Style="{StaticResource WorkspaceCardStyle}"
            Panel.ZIndex="5"
            Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.2"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Ticket details" Style="{StaticResource SectionTitleTextStyle}"/>
                        <TextBlock
                            x:Name="DetailsStatusText"
                            Margin="0,5,0,0"
                            Style="{StaticResource SmallMutedTextStyle}"/>
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Content="×"
                        Style="{StaticResource ClosePanelButtonStyle}"
                        Click="CloseDetailsButton_Click"/>
                </Grid>

                <ScrollViewer Grid.Row="1" Margin="0,22,0,18" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Author" Style="{StaticResource DetailLabelTextStyle}"/>
                        <TextBlock x:Name="DetailsAuthorNameText" Style="{StaticResource DetailValueTextStyle}"/>
                        <TextBlock
                            x:Name="DetailsAuthorEmailText"
                            Margin="0,4,0,18"
                            Style="{StaticResource SmallMutedTextStyle}"/>

                        <TextBlock Text="Title" Style="{StaticResource DetailLabelTextStyle}"/>
                        <TextBlock
                            x:Name="DetailsTitleText"
                            Margin="0,0,0,18"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource MainTextBrush}"
                            TextWrapping="Wrap"/>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Priority" Style="{StaticResource DetailLabelTextStyle}"/>
                                <TextBlock x:Name="DetailsPriorityText" Style="{StaticResource DetailValueTextStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Created" Style="{StaticResource DetailLabelTextStyle}"/>
                                <TextBlock x:Name="DetailsCreatedText" Style="{StaticResource DetailValueTextStyle}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Problem type" Style="{StaticResource DetailLabelTextStyle}"/>
                        <TextBlock
                            x:Name="DetailsProblemTypeText"
                            Margin="0,0,0,16"
                            Style="{StaticResource DetailValueTextStyle}"/>

                        <TextBlock Text="Work impact" Style="{StaticResource DetailLabelTextStyle}"/>
                        <TextBlock
                            x:Name="DetailsWorkImpactText"
                            Margin="0,0,0,16"
                            Style="{StaticResource DetailValueTextStyle}"/>

                        <TextBlock Text="Affected people" Style="{StaticResource DetailLabelTextStyle}"/>
                        <TextBlock
                            x:Name="DetailsAffectedPeopleText"
                            Margin="0,0,0,18"
                            Style="{StaticResource DetailValueTextStyle}"/>

                        <TextBlock Text="Description" Style="{StaticResource DetailLabelTextStyle}"/>
                        <Border
                            Padding="14"
                            Background="{StaticResource InputBackgroundBrush}"
                            BorderBrush="{StaticResource InputBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <TextBlock x:Name="DetailsDescriptionText" Style="{StaticResource DetailValueTextStyle}"/>
                        </Border>

                        <TextBlock
                            Text="Comments"
                            Margin="0,18,0,8"
                            Style="{StaticResource DetailLabelTextStyle}"/>
                        <ItemsControl
                            ItemsSource="{Binding Responses}"
                            ItemTemplate="{StaticResource TicketCommentTemplate}"/>
                        <TextBlock Text="No comments yet.">
                            <TextBlock.Style>
                                <Style
                                    TargetType="TextBlock"
                                    BasedOn="{StaticResource SmallMutedTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Responses.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock
                            Text="Change history"
                            Margin="0,18,0,8"
                            Style="{StaticResource DetailLabelTextStyle}"/>
                        <ItemsControl
                            ItemsSource="{Binding HistoryEntries}"
                            ItemTemplate="{StaticResource TicketHistoryEntryTemplate}"/>
                        <TextBlock Text="No history entries yet.">
                            <TextBlock.Style>
                                <Style
                                    TargetType="TextBlock"
                                    BasedOn="{StaticResource SmallMutedTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HistoryEntries.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2">
                    <TextBlock
                        x:Name="TicketActionMessageText"
                        Margin="0,0,0,10"
                        Style="{StaticResource WorkspaceErrorTextStyle}"/>

                    <StackPanel x:Name="OpenTicketActionsPanel">
                        <Button
                            x:Name="TakeTicketButton"
                            Content="Take ticket"
                            Margin="0,0,0,14"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="TakeTicketButton_Click"/>
                        <TextBlock Text="Decline reason" Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBox
                            x:Name="DeclineReasonTextBox"
                            MaxLength="300"
                            Style="{StaticResource WorkspaceTextAreaStyle}"
                            TextChanged="DeclineReasonTextBox_TextChanged"/>
                        <TextBlock
                            x:Name="TicketDeclineReasonErrorText"
                            Margin="0,5,0,10"
                            Style="{StaticResource WorkspaceErrorTextStyle}"/>
                        <Button
                            x:Name="DeclineTicketButton"
                            Content="Decline ticket"
                            Style="{StaticResource DangerButtonStyle}"
                            Click="DeclineTicketButton_Click"/>
                    </StackPanel>

                    <StackPanel
                        x:Name="AssignedTicketActionsPanel"
                        Visibility="Collapsed">
                        <TextBlock Text="Comment" Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBox
                            x:Name="AdminCommentTextBox"
                            Margin="0,0,0,10"
                            MaxLength="300"
                            Style="{StaticResource WorkspaceTextAreaStyle}"/>
                        <Button
                            x:Name="AddAdminCommentButton"
                            Content="Add comment"
                            Margin="0,0,0,10"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="AddAdminCommentButton_Click"/>
                        <TextBlock
                            x:Name="TicketCommentErrorText"
                            Margin="0,0,0,14"
                            Style="{StaticResource WorkspaceErrorTextStyle}"/>
                        <TextBlock
                            x:Name="TicketCommentSuccessText"
                            Margin="0,0,0,14"
                            Style="{StaticResource WorkspaceSuccessTextStyle}"/>
                        <TextBlock Text="Resolution note (optional)" Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBox
                            x:Name="ResolutionTextBox"
                            Margin="0,0,0,14"
                            MaxLength="500"
                            Style="{StaticResource WorkspaceTextAreaStyle}"/>
                        <Button
                            x:Name="CompleteTicketButton"
                            Content="Complete ticket"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="CompleteTicketButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border
            x:Name="RegistrationRequestsPanel"
            Width="900"
            Margin="0,126,28,28"
            Padding="24"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            Style="{StaticResource WorkspaceCardStyle}"
            Panel.ZIndex="6"
            Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.2"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Registration requests" Style="{StaticResource SectionTitleTextStyle}"/>
                        <TextBlock
                            x:Name="RegistrationRequestsCountText"
                            Margin="0,5,0,0"
                            Style="{StaticResource SmallMutedTextStyle}"/>
                        <TextBlock
                            x:Name="RegistrationStatusMessageText"
                            Margin="0,5,0,0"
                            Style="{StaticResource WorkspaceMessageTextStyle}"/>
                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        Content="Refresh"
                        Margin="0,0,12,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="RefreshRegistrationRequestsButton_Click"/>
                    <Button
                        Grid.Column="2"
                        Content="×"
                        Style="{StaticResource ClosePanelButtonStyle}"
                        Click="CloseRegistrationRequestsButton_Click"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*"/>
                        <ColumnDefinition Width="5*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Margin="0,0,18,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl
                                x:Name="RegistrationRequestsList"
                                ItemTemplate="{StaticResource RegistrationRequestCardTemplate}"/>
                        </ScrollViewer>
                        <TextBlock
                            x:Name="RegistrationRequestsEmptyText"
                            Text="There are no pending registration requests."
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            TextAlignment="Center"
                            Style="{StaticResource SmallMutedTextStyle}"
                            Visibility="Collapsed"/>
                    </Grid>

                    <Border
                        Grid.Column="1"
                        Padding="20"
                        Background="{StaticResource InputBackgroundBrush}"
                        BorderBrush="{StaticResource InputBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <Grid>
                            <TextBlock
                                x:Name="RegistrationSelectionHintText"
                                Text="Select a request to review it."
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Style="{StaticResource SmallMutedTextStyle}"/>

                            <ScrollViewer
                                x:Name="RegistrationDetailsContent"
                                VerticalScrollBarVisibility="Auto"
                                Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Applicant" Style="{StaticResource DetailLabelTextStyle}"/>
                                    <TextBlock
                                        x:Name="RegistrationApplicantNameText"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource MainTextBrush}"
                                        TextWrapping="Wrap"/>
                                    <TextBlock
                                        x:Name="RegistrationApplicantEmailText"
                                        Margin="0,4,0,18"
                                        Style="{StaticResource SmallMutedTextStyle}"/>

                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock
                                                Text="Requested role"
                                                Style="{StaticResource DetailLabelTextStyle}"/>
                                            <TextBlock
                                                x:Name="RegistrationRequestedRoleText"
                                                Style="{StaticResource DetailValueTextStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Requested" Style="{StaticResource DetailLabelTextStyle}"/>
                                            <TextBlock
                                                x:Name="RegistrationCreatedText"
                                                Style="{StaticResource DetailValueTextStyle}"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Assigned role" Style="{StaticResource FieldLabelTextStyle}"/>
                                    <ComboBox
                                        x:Name="AssignedRoleComboBox"
                                        Margin="0,0,0,14"
                                        Style="{StaticResource AuthComboBoxStyle}"/>
                                    <Button
                                        x:Name="ApproveRegistrationRequestButton"
                                        Content="Approve and create user"
                                        Margin="0,0,0,18"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="ApproveRegistrationRequestButton_Click"/>

                                    <TextBlock Text="Decline reason" Style="{StaticResource FieldLabelTextStyle}"/>
                                    <TextBox
                                        x:Name="RegistrationDeclineReasonTextBox"
                                        MaxLength="300"
                                        Style="{StaticResource WorkspaceTextAreaStyle}"
                                        TextChanged="RegistrationDeclineReasonTextBox_TextChanged"/>
                                    <TextBlock
                                        x:Name="RegistrationDeclineReasonErrorText"
                                        Margin="0,5,0,10"
                                        Style="{StaticResource WorkspaceErrorTextStyle}"/>
                                    <Button
                                        x:Name="DeclineRegistrationRequestButton"
                                        Content="Decline request"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Click="DeclineRegistrationRequestButton_Click"/>

                                    <TextBlock
                                        x:Name="RegistrationFormErrorText"
                                        Margin="0,12,0,0"
                                        Style="{StaticResource WorkspaceErrorTextStyle}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Border
            x:Name="KnowledgeBasePanel"
            Margin="28,126,28,28"
            Padding="24"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Style="{StaticResource WorkspaceCardStyle}"
            Panel.ZIndex="7"
            Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.2"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Knowledge base" Style="{StaticResource SectionTitleTextStyle}"/>
                        <TextBlock
                            Text="Ticket archive and processed account registrations"
                            Margin="0,5,0,0"
                            Style="{StaticResource SmallMutedTextStyle}"/>
                        <TextBlock
                            x:Name="KnowledgeBaseStatusMessageText"
                            Margin="0,5,0,0"
                            Style="{StaticResource WorkspaceErrorTextStyle}"/>
                        <TextBlock
                            x:Name="KnowledgeBaseSuccessMessageText"
                            Margin="0,5,0,0"
                            Style="{StaticResource WorkspaceSuccessTextStyle}"/>
                    </StackPanel>

                    <Button
                        x:Name="RefreshKnowledgeBaseButton"
                        Grid.Column="1"
                        Content="Refresh"
                        Margin="0,0,12,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="RefreshKnowledgeBaseButton_Click"/>
                    <Button
                        Grid.Column="2"
                        Content="×"
                        Style="{StaticResource ClosePanelButtonStyle}"
                        Click="CloseKnowledgeBaseButton_Click"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock
                            Text="Search tickets and registrations"
                            Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBox
                            x:Name="KnowledgeBaseSearchTextBox"
                            MaxLength="80"
                            ToolTip="Search by ticket ID, text, comment, applicant or email"
                            Style="{StaticResource WorkspaceTextBoxStyle}"
                            TextChanged="KnowledgeBaseSearchTextBox_TextChanged"/>
                    </StackPanel>

                    <Button
                        x:Name="ClearKnowledgeBaseSearchButton"
                        Grid.Column="1"
                        Content="Clear"
                        Margin="12,0,0,0"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="False"
                        Click="ClearKnowledgeBaseSearchButton_Click"/>
                </Grid>

                <StackPanel Grid.Row="2" Margin="0,18,0,18" Orientation="Horizontal">
                    <Button
                        x:Name="CompletedKnowledgeBaseButton"
                        Content="Completed"
                        Tag="Selected"
                        Style="{StaticResource KnowledgeBaseNavigationButtonStyle}"
                        Click="CompletedKnowledgeBaseButton_Click"/>
                    <Button
                        x:Name="DeclinedKnowledgeBaseButton"
                        Content="Declined"
                        Style="{StaticResource KnowledgeBaseNavigationButtonStyle}"
                        Click="DeclinedKnowledgeBaseButton_Click"/>
                    <Button
                        x:Name="InProgressKnowledgeBaseButton"
                        Content="In progress"
                        Style="{StaticResource KnowledgeBaseNavigationButtonStyle}"
                        Click="InProgressKnowledgeBaseButton_Click"/>
                    <Button
                        x:Name="RegistrationsKnowledgeBaseButton"
                        Content="Registrations"
                        Style="{StaticResource KnowledgeBaseNavigationButtonStyle}"
                        Click="RegistrationsKnowledgeBaseButton_Click"/>
                </StackPanel>

                <Grid Grid.Row="3">
                    <Grid x:Name="CompletedKnowledgeBaseView">
                        <ScrollViewer
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl
                                x:Name="CompletedKnowledgeBaseList"
                                ItemTemplate="{StaticResource KnowledgeBaseTicketCardTemplate}"/>
                        </ScrollViewer>
                        <TextBlock
                            x:Name="CompletedKnowledgeBaseEmptyText"
                            Text="There are no completed tickets yet."
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Style="{StaticResource SmallMutedTextStyle}"
                            Visibility="Collapsed"/>
                    </Grid>

                    <Grid x:Name="DeclinedKnowledgeBaseView" Visibility="Collapsed">
                        <ScrollViewer
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl
                                x:Name="DeclinedKnowledgeBaseList"
                                ItemTemplate="{StaticResource KnowledgeBaseTicketCardTemplate}"/>
                        </ScrollViewer>
                        <TextBlock
                            x:Name="DeclinedKnowledgeBaseEmptyText"
                            Text="There are no declined tickets yet."
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Style="{StaticResource SmallMutedTextStyle}"
                            Visibility="Collapsed"/>
                    </Grid>

                    <Grid x:Name="InProgressKnowledgeBaseView" Visibility="Collapsed">
                        <ScrollViewer
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl
                                x:Name="InProgressKnowledgeBaseList"
                                ItemTemplate="{StaticResource KnowledgeBaseTicketCardTemplate}"/>
                        </ScrollViewer>
                        <TextBlock
                            x:Name="InProgressKnowledgeBaseEmptyText"
                            Text="There are no tickets in progress."
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Style="{StaticResource SmallMutedTextStyle}"
                            Visibility="Collapsed"/>
                    </Grid>

                    <Grid x:Name="RegistrationsKnowledgeBaseView" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock
                                Text="Approved registrations"
                                Margin="0,0,0,12"
                                Style="{StaticResource SectionTitleTextStyle}"/>
                            <Grid Grid.Row="1">
                                <ScrollViewer
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl
                                        x:Name="ApprovedRegistrationsList"
                                        ItemTemplate="{StaticResource RegistrationArchiveCardTemplate}"/>
                                </ScrollViewer>
                                <TextBlock
                                    x:Name="ApprovedRegistrationsEmptyText"
                                    Text="There are no approved registrations yet."
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    TextAlignment="Center"
                                    Style="{StaticResource SmallMutedTextStyle}"
                                    Visibility="Collapsed"/>
                            </Grid>
                        </Grid>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock
                                Text="Declined registrations"
                                Margin="0,0,0,12"
                                Style="{StaticResource SectionTitleTextStyle}"/>
                            <Grid Grid.Row="1">
                                <ScrollViewer
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl
                                        x:Name="DeclinedRegistrationsList"
                                        ItemTemplate="{StaticResource RegistrationArchiveCardTemplate}"/>
                                </ScrollViewer>
                                <TextBlock
                                    x:Name="DeclinedRegistrationsEmptyText"
                                    Text="There are no declined registrations yet."
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    TextAlignment="Center"
                                    Style="{StaticResource SmallMutedTextStyle}"
                                    Visibility="Collapsed"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
